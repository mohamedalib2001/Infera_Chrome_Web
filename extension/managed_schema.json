{
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean", "title": "Enable Infera Agent for the organization", "description": "When false the agent refuses to run." },
    "allowlist": { "type": "array", "items": { "type": "string" }, "title": "Only these domains may be used by the agent (empty = all)" },
    "blocklist": { "type": "array", "items": { "type": "string" }, "title": "Domains that are always blocked" },
    "defaultPermissionMode": { "type": "string", "enum": ["ask", "auto", "follow_a_plan", "skip_all_permission_checks"], "title": "Default permission mode" },
    "disableSkipAllApprovals": { "type": "boolean", "title": "Hide the 'Skip all approvals' mode" },
    "relayUrl": { "type": "string", "title": "Cloud bridge relay URL (wss://)" }
  }
}
